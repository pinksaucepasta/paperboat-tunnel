{
  "schema_version": 1,
  "metrics": [
    {
      "name": "paperboat_tunnel_active_streams",
      "kind": "gauge"
    },
    {
      "name": "paperboat_tunnel_attached_routes",
      "kind": "gauge"
    },
    {
      "name": "paperboat_tunnel_certificate_expiry_timestamp_seconds",
      "kind": "gauge"
    },
    {
      "name": "paperboat_tunnel_connector_capacity",
      "kind": "gauge"
    },
    {
      "name": "paperboat_tunnel_connectors",
      "kind": "gauge"
    },
    {
      "name": "paperboat_tunnel_dependency_healthy",
      "kind": "gauge",
      "labels": {
        "dependency": [
          "caddy",
          "control",
          "frps",
          "routes",
          "signaling",
          "stun",
          "usage"
        ]
      }
    },
    {
      "name": "paperboat_tunnel_events_total",
